---
interface TimelineItem {
  semana: number;
  titulo: string;
  descripcion: string;
}

interface Props {
  timeline: TimelineItem[];
  colorAccent: string;
}

const { timeline, colorAccent } = Astro.props;
---

<section class="py-24 px-6 relative overflow-hidden bg-[#131a22]">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-1 rounded-full text-sm font-medium text-primary-400 bg-primary-400/10 border border-primary-400/20 mb-4">
        Cronograma
      </span>
    </div>

    <div class="relative">
      <div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-primary-400/20 to-transparent hidden md:block"></div>

      <div class="space-y-8">
        {timeline.map((item, index) => (
          <div class={`relative flex items-center gap-6 md:gap-0 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <div class="flex-1 md:text-right">
              {index % 2 === 0 && (
                <div class="hidden md:block p-4 rounded-2xl border border-white/10 bg-white/[0.02]">
                  <h3 class="text-base font-bold text-white mb-1">{item.titulo}</h3>
                  <p class="text-white/50 text-sm">{item.descripcion}</p>
                </div>
              )}
            </div>

            <div class="hidden md:flex absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full items-center justify-center text-white font-bold text-sm z-10 bg-primary-400">
              S{item.semana}
            </div>

            <div class="flex-1 md:text-left">
              {index % 2 !== 0 && (
                <div class="hidden md:block p-4 rounded-2xl border border-white/10 bg-white/[0.02]">
                  <h3 class="text-base font-bold text-white mb-1">{item.titulo}</h3>
                  <p class="text-white/50 text-sm">{item.descripcion}</p>
                </div>
              )}

              <div class="md:hidden p-4 rounded-2xl border border-white/10 bg-white/[0.02]">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0 bg-primary-400">
                    S{item.semana}
                  </div>
                  <h3 class="text-base font-bold text-white">{item.titulo}</h3>
                </div>
                <p class="text-white/50 text-sm">{item.descripcion}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-white/5">
          <div class="w-2 h-2 rounded-full bg-primary-400"></div>
          <span class="text-white/50 text-sm">Listo para lanzar</span>
        </div>
      </div>
    </div>
  </div>
</section>