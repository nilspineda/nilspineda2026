---
interface Plan {
  nombre: string;
  precio: string;
  precioInfo: string;
  destacado: boolean;
  incluye: string[];
}

interface Props {
  planes: Plan[];
  colorAccent: string;
  whatsapp: string;
  cliente: string;
}

const { planes, colorAccent, whatsapp, cliente } = Astro.props;

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
---

<section id="planes" class="py-24 px-6 relative overflow-hidden bg-[#131a22]">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-20 right-20 w-48 h-48 rounded-full blur-3xl bg-primary-400/20"></div>
  </div>

  <div class="max-w-6xl mx-auto relative z-10">
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-1 rounded-full text-sm font-medium text-primary-400 bg-primary-400/10 border border-primary-400/20 mb-4">
        Inversión
      </span>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-16">
      {planes.map((plan) => (
        <div class={`relative p-6 rounded-3xl border transition-all duration-300 ${
          plan.destacado
            ? 'border-primary-400/50 bg-primary-400/5'
            : 'border-white/10 bg-white/[0.02]'
        }`}>
          {plan.destacado && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full text-xs font-bold text-white bg-primary-400">
              Más Popular
            </div>
          )}

          <div class="text-center mb-4">
            <h3 class="text-lg font-bold text-white mb-1">{plan.nombre}</h3>
            <p class="text-white/40 text-sm">{plan.precioInfo}</p>
          </div>

          <div class="text-center mb-6">
            <span class="text-3xl md:text-4xl font-bold text-primary-400">
              {plan.precio}
            </span>
          </div>

          <div class="space-y-2 mb-6">
            {plan.incluye.map((item) => (
              <div class="flex items-start gap-2">
                <div class="w-4 h-4 rounded-full flex items-center justify-center shrink-0 mt-0.5 bg-primary-400/20 text-primary-400" set:html={checkIcon} />
                <span class="text-white/60 text-sm">{item}</span>
              </div>
            ))}
          </div>

          <a
            href={`https://wa.me/${whatsapp}?text=Hola,%20vengo%20de%20la%20propuesta%20de%20${cliente}%20y%20me%20interesa%20el%20plan%20${plan.nombre}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`block w-full py-3 rounded-xl font-bold text-center transition-all duration-300 ${
              plan.destacado
                ? 'text-white bg-primary-400 hover:bg-primary-500'
                : 'border border-white/20 text-white hover:bg-white/10'
            }`}
          >
            {plan.destacado ? 'Comenzar Ahora' : 'Elegir Plan'}
          </a>
        </div>
      ))}
    </div>

    <div class="text-center">
      <p class="text-white/40 text-sm">
        ¿Necesitas un plan personalizado? <a href={`https://wa.me/${whatsapp}?text=Hola,%20quiero%20un%20plan%20personalizado`} class="text-primary-400 underline hover:text-primary-300">Hablemos</a>
      </p>
    </div>
  </div>
</section>