---
import LayoutNav from "../layouts/Layout-nav.astro";
---

<LayoutNav
  title="Inscripción | Nils Pineda"
  description="Regístrate con los datos de tu emprendimiento para conectar y hacer crecer tu marca digital."
>
  <main
    class="relative min-h-dvh flex flex-col items-center justify-center px-6 py-24 overflow-hidden"
  >
    <div class="fixed inset-0 -z-10"></div>

    <div
      class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
    >
      <!-- Lado izquierdo: Texto -->
      <div class="text-center lg:text-left">
        <h1
          class="text-white text-5xl md:text-6xl font-bold mb-6 leading-tight"
        >
          Registra tu <span class="text-primary-400">emprendimiento</span>
        </h1>
        <p class="text-gray-400 text-lg mb-8 max-w-md mx-auto lg:mx-0">
          Completa el formulario y cuéntame sobre tu proyecto. Juntos haremos
          que tu marca destaque en el mundo digital.
        </p>

        <div class="flex flex-col gap-4 items-center lg:items-start">
          <div class="flex items-center gap-3 text-white/80">
            <span class="flex h-3 w-3 relative">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-3 w-3 bg-primary-500"
              ></span>
            </span>
            Cupos limitados
          </div>
          <a
            href="mailto:info@nilspineda.com"
            class="text-primary-400 hover:underline font-medium"
            >info@nilspineda.com</a
          >
        </div>
      </div>

      <!-- Lado derecho: Formulario -->
      <div
        class="bg-white/3 backdrop-blur-xl border border-white/10 p-8 rounded-[2.5rem] shadow-2xl"
      >
        <form id="inscription-form" class="flex flex-col gap-5">
          <!-- Nombre -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2">Nombre</label>
            <input
              type="text"
              name="nombre"
              required
              placeholder="Tu nombre completo"
              class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all placeholder:text-white/20"
            />
          </div>

          <!-- WhatsApp -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2">WhatsApp</label>
            <input
              type="tel"
              name="whatsapp"
              required
              placeholder="+57 300 000 0000"
              class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all placeholder:text-white/20"
            />
          </div>

          <!-- Correo -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2">Correo</label>
            <input
              type="email"
              name="correo"
              required
              placeholder="tu@email.com"
              class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all placeholder:text-white/20"
            />
          </div>

          <!-- Nombre Emprendimiento -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2"
              >Nombre del emprendimiento</label
            >
            <input
              type="text"
              name="emprendimiento"
              required
              placeholder="El nombre de tu negocio o marca"
              class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all placeholder:text-white/20"
            />
          </div>

          <!-- Redes del emprendimiento (opcional) -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2"
              >Redes del emprendimiento
              <span class="text-white/30">(opcional)</span></label
            >
            <input
              type="text"
              name="redes"
              placeholder="@tuemprendimiento o URL de redes"
              class="bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all placeholder:text-white/20"
            />
          </div>

          <!-- Municipio -->
          <div class="flex flex-col gap-2">
            <label class="text-white/60 text-sm ml-2">Municipio</label>
            <div class="relative">
              <select
                name="municipio"
                required
                class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white outline-none focus:border-primary-400 transition-all appearance-none cursor-pointer"
              >
                <option
                  value=""
                  disabled
                  selected
                  class="bg-accent text-white/40"
                  >Selecciona tu municipio</option
                >
                <option value="Bucaramanga" class="bg-accent text-white"
                  >Bucaramanga</option
                >
                <option value="Floridablanca" class="bg-accent text-white"
                  >Floridablanca</option
                >
                <option value="Girón" class="bg-accent text-white">Girón</option
                >
                <option value="Piedecuesta" class="bg-accent text-white"
                  >Piedecuesta</option
                >
              </select>
              <!-- Flecha personalizada -->
              <svg
                class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-white/40"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 9l6 6 6-6"></path>
              </svg>
            </div>
          </div>

          <!-- Botón enviar -->
          <button
            type="submit"
            id="submit-btn"
            class="mt-4 bg-primary-400 text-accent font-bold py-4 rounded-2xl hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 group disabled:opacity-50 disabled:cursor-not-allowed shadow-lg shadow-primary-400/20"
          >
            <span id="btn-text">Enviar inscripción</span>
            <svg
              id="btn-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:translate-x-1 transition-transform"
            >
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>

          <!-- Estado -->
          <p
            id="response-status"
            class="text-center text-sm font-medium mt-2 hidden"
          >
          </p>
        </form>
      </div>
    </div>
  </main>
</LayoutNav>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("inscription-form") as HTMLFormElement;
  const btn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");
  const status = document.getElementById("response-status");

  function showStatus(message: string, type: "success" | "error" | "warning") {
    const colorMap = {
      success: "text-primary-400",
      error: "text-red-400",
      warning: "text-yellow-400",
    };
    status!.innerText = message;
    status!.className = `${colorMap[type]} text-center text-sm font-medium mt-2 block${type === "success" ? " animate-bounce" : ""}`;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const nombre = (
      form.querySelector("input[name='nombre']") as HTMLInputElement
    )?.value.trim();
    const whatsapp = (
      form.querySelector("input[name='whatsapp']") as HTMLInputElement
    )?.value.trim();
    const correo = (
      form.querySelector("input[name='correo']") as HTMLInputElement
    )?.value.trim();
    const emprendimiento = (
      form.querySelector("input[name='emprendimiento']") as HTMLInputElement
    )?.value.trim();
    const redes = (
      form.querySelector("input[name='redes']") as HTMLInputElement
    )?.value.trim();
    const municipio = (
      form.querySelector("select[name='municipio']") as HTMLSelectElement
    )?.value;

    // Validación de campos requeridos
    if (!nombre || !whatsapp || !correo || !emprendimiento || !municipio) {
      showStatus("Por favor completa todos los campos requeridos.", "warning");
      return;
    }

    // Validar formato de correo
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(correo)) {
      showStatus("Por favor ingresa un correo válido.", "warning");
      return;
    }

    // Estado de carga
    btn.disabled = true;
    btnText!.innerText = "Enviando...";
    status!.classList.add("hidden");

    try {
      const { error } = await supabase.from("inscripciones").insert([
        {
          nombre,
          whatsapp,
          correo,
          emprendimiento,
          redes: redes || null,
          municipio,
        },
      ]);

      if (error) {
        console.error("Supabase error:", error);
        throw new Error(error.message);
      }

      showStatus(
        "¡Inscripción enviada exitosamente! Te contactaremos pronto. 🎉",
        "success",
      );
      form.reset();
    } catch (error) {
      const errorText =
        error instanceof Error ? error.message : "Error desconocido";
      console.error("Formulario error:", errorText);
      showStatus(`❌ ${errorText.substring(0, 80)}`, "error");
    } finally {
      btn.disabled = false;
      btnText!.innerText = "Enviar inscripción";
    }
  });
</script>
